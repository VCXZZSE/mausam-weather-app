# ---------------------------------------------------------------------------
# CLIENT (Vite) — inlined into the browser bundle at build time. Only ever
# put values here that are safe to be publicly visible; never a secret.
# Used for LOCAL DEV ONLY, to point the frontend at the Fastify backend
# (`npm run dev:backend`) instead of Vercel's serverless functions. Leave
# these unset in Vercel — the frontend already defaults to the relative
# `/api/weather`, `/api/location/search`, `/api/location/reverse` serverless
# functions in that case (see src/weatherData.ts, src/location.ts).
# ---------------------------------------------------------------------------
VITE_WEATHER_API_URL=http://localhost:3000/api/weather
VITE_WEATHER_REFRESH_MS=60000
VITE_PERSONALIZED_BRIEFING_API_URL=http://localhost:3000/api/personalized-briefing
VITE_LOCATION_REVERSE_API_URL=http://localhost:3000/api/location/reverse
VITE_LOCATION_SEARCH_API_URL=http://localhost:3000/api/location/search
# Explicit opt-in flag for the local static demo dataset (backend-v0.2
# handoff §9) — leave unset/false to require a real resolved location and
# live backend response; set true only for screenshots/offline development.
VITE_USE_DEMO_WEATHER=false

# ---------------------------------------------------------------------------
# SERVER-SIDE (api/weather.ts, running as a Vercel serverless function in
# production, or the Fastify backend locally) — read via process.env, NEVER
# bundled into client code. Do NOT prefix these with VITE_; doing so would
# expose them in the browser bundle.
#
# For production, set this in Vercel → Project Settings → Environment
# Variables (a repository .env file is never read by Vercel). Locally, the
# Fastify backend reads its own backend/.env (see backend/.env.example);
# api/weather.ts (used only when running against Vercel's dev/prod
# environment) reads it from this file or your shell environment.
#
# CPCB (Central Pollution Control Board) real-time station AQI — India's
# National AQI, the app's only AQI standard. Free registration:
#   1. Sign up at https://www.data.gov.in/user/register
#   2. Go to https://www.data.gov.in/user (My Account) and copy your API key
# Leave empty/unset to omit the AQI section entirely — the app never
# fabricates AQI or substitutes a different country's standard (e.g. US AQI)
# when this key is missing; every other weather field still works normally.
DATA_GOV_IN_API_KEY=

# The remaining server-side tuning variables (OPEN_METEO_BASE_URL,
# WEATHER_CACHE_TTL_MS, DATA_GOV_IN_BASE_URL, CPCB_CACHE_TTL_MS,
# CPCB_MAX_STATION_DISTANCE_KM, ALLOW_DEFAULT_LOCATION, DEFAULT_LATITUDE,
# DEFAULT_LONGITUDE, DEFAULT_CITY, DEFAULT_REGION) all have working defaults
# — see lib/config/env.ts — and only need overriding for advanced
# tuning, never for basic production correctness.
