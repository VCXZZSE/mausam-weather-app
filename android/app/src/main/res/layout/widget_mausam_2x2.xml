<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_sunny"
    android:padding="16dp">

    <!-- Top Section: Location & Condition on Left, Weather Icon on Right -->
    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_toStartOf="@id/widget_icon"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.06"
            android:maxLines="1"
            android:text="MAUSAM"
            android:textAllCaps="true"
            android:textColor="#FFBE50"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/widget_condition"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:letterSpacing="0.03"
            android:maxLines="1"
            android:text="Loading..."
            android:textColor="#FFAA3C"
            android:textSize="9sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_icon"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:layout_marginTop="-2dp"
        android:contentDescription="Weather Icon"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_widget_sun" />

    <!-- Center Temperature -->
    <TextView
        android:id="@+id/widget_temperature"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:fontFamily="sans-serif-light"
        android:includeFontPadding="false"
        android:letterSpacing="-0.03"
        android:text="--°"
        android:textColor="#FFDC78"
        android:textSize="50sp" />

    <!-- Bottom Hi / Lo Readout -->
    <LinearLayout
        android:id="@+id/widget_footer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_high"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.02"
            android:text="H: --°"
            android:textColor="#FFBE50"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/widget_low"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.02"
            android:text="L: --°"
            android:textColor="#FFBE50"
            android:textSize="10sp" />
    </LinearLayout>

</RelativeLayout>
