# ---------------------------------------------------------------------------
# ANDROID BUILD CONFIGURATION — committed on purpose, contains no secrets.
#
# Loaded by `vite build --mode android`, which is what `npm run android`,
# `npm run android:sync` and `npm run android:run` use. Vite applies
# `.env.android` AFTER `.env` and `.env.local`, so the values here override
# whatever local development URLs a contributor happens to have.
#
# WHY THIS FILE EXISTS
# Inside the packaged app the web bundle is served by Capacitor from
# `https://localhost`, on the phone itself. Anything relative (`/api/weather`)
# or pointed at `http://localhost:3000` therefore resolves to the PHONE, not to
# a server, and every request fails. The packaged app must call an absolute,
# publicly reachable HTTPS origin — that is the whole purpose of this file.
#
# If the deployment moves, change the two URLs below and rebuild.
# ---------------------------------------------------------------------------

# Production Vercel serverless endpoints (see README → Deploy to Vercel).
VITE_WEATHER_API_URL=https://mausam-roan.vercel.app/api/weather
# Only consumed by LiveOfficialAdvisories, which the dashboard does not render
# yet (the advisory card is deliberately in its safe "unavailable" state).
# Set here so enabling that card needs no further build configuration.
VITE_ADVISORIES_API_URL=https://mausam-roan.vercel.app/api/advisories
VITE_WEATHER_REFRESH_MS=60000

# Never ship the demo dataset in a real build.
VITE_USE_DEMO_WEATHER=false

# Deliberately blanked, NOT deleted. A contributor's `.env` sets these to
# http://localhost:3000; leaving them out here would let those localhost values
# survive into the APK. Empty means "unconfigured", which makes the app use its
# built-in direct providers (Nominatim geocoding) and its local briefing
# computation — the same behaviour as the production website, which has no
# serverless counterpart for these routes.
VITE_LOCATION_SEARCH_API_URL=
VITE_LOCATION_REVERSE_API_URL=
VITE_PERSONALIZED_BRIEFING_API_URL=
