{
  "name": "mausam-weather-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:all",
    "dev:frontend": "vite --host 0.0.0.0",
    "dev:backend": "cd backend && npm run dev",
    "dev:all": "concurrently --names \"frontend,backend\" --prefix-colors \"cyan,yellow\" \"npm run dev:frontend\" \"npm run dev:backend\"",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "build:android": "vite build --mode android && node scripts/verify-android-bundle.mjs",
    "android": "npm run android:sync && npx cap open android",
    "android:sync": "npm run build:android && npx cap sync android",
    "android:run": "npm run android:sync && npx cap run android",
    "format": "oxfmt"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/geolocation": "^8.2.2",
    "fast-xml-parser": "^5.11.1",
    "lucide-react": "^1.47.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "suncalc": "^1.9.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/suncalc": "^1.9.2",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^9.2.4",
    "jsdom": "^25.0.1",
    "oxfmt": "^0.2.0",
    "rolldown": "^1.0.0-beta.52",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
