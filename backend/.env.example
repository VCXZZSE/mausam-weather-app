PORT=3000
ALLOWED_ORIGINS=http://localhost:8443,http://localhost:5173
WEATHER_CACHE_TTL_MS=300000
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_AIR_QUALITY_URL=https://air-quality-api.open-meteo.com/v1/air-quality
AIR_QUALITY_CACHE_TTL_MS=600000
ALLOW_DEFAULT_LOCATION=true
DEFAULT_LATITUDE=22.5726
DEFAULT_LONGITUDE=88.3639
DEFAULT_CITY=Kolkata
DEFAULT_REGION=West Bengal
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
LOCATION_SEARCH_CACHE_TTL_MS=3600000
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org/reverse
NOMINATIM_USER_AGENT=MausamWeatherApp/1.0 (SIH demo; contact: local-dev)
REVERSE_GEOCODE_CACHE_TTL_MS=86400000
REVERSE_GEOCODE_MIN_INTERVAL_MS=1000

# CPCB (Central Pollution Control Board) real-time station AQI — India's
# National AQI, preferred over Open-Meteo's modeled US AQI when available.
# Free registration, no cost:
#   1. Sign up at https://www.data.gov.in/user/register (free)
#   2. Go to https://www.data.gov.in/user (My Account) and copy your API key
#   3. Paste it below as DATA_GOV_IN_API_KEY — NEVER commit a real key
# Leave DATA_GOV_IN_API_KEY empty to skip CPCB entirely (no network call is
# attempted) and use only the existing free Open-Meteo AQI, clearly labeled
# as such in the response (`source: "OPEN_METEO"`, `standard: "US_AQI"`).
DATA_GOV_IN_API_KEY=
DATA_GOV_IN_BASE_URL=https://api.data.gov.in/resource/3b01bcb8-0b14-4abf-b6f2-c1bfd384ba69
CPCB_CACHE_TTL_MS=1800000
CPCB_MAX_STATION_DISTANCE_KM=50
